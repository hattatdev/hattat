{
  "name": "@hattatdev/figures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "license": "MIT",
  "description": "Original, deterministic figure definitions with separate tree-shakable entries.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hattatdev/hattat.git",
    "directory": "packages/figures"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hattatdev/core": "workspace:*"
  }
}
