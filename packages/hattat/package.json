{
  "name": "hattat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./figures/*": {
      "types": "./dist/figures/*.d.ts",
      "import": "./dist/figures/*.js"
    }
  },
  "license": "MIT",
  "description": "The future single npm distribution facade and its public subpath entries.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hattatdev/hattat.git",
    "directory": "packages/hattat"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hattatdev/core": "workspace:*",
    "@hattatdev/figures": "workspace:*",
    "@hattatdev/cli": "workspace:*"
  }
}
